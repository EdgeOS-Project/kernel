	$(SRC)/drivers/usb/xhci_device_policy.c \
	$(SRC)/console.c \
	$(SRC)/display.c \
	$(SRC)/display_edid.c \
	$(SRC)/fb.c \
	$(SRC)/fb_console.c \
	$(SRC)/font8x8_basic.c \
	$(SRC)/string.c \
	$(SRC)/stdio.c \
	$(SRC)/sys/bootlog.c \
	$(SRC)/block/block.c \
	$(SRC)/block/device_mapper.c \
	$(SRC)/block/loop.c \
