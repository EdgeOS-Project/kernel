# Architecture-independent EdgeOS kernel sources.
#
# Both architecture targets must converge on this manifest.  Architecture
# Makefile fragments may append mechanisms only; Linux-visible policy belongs
# here.
EDGE_SHARED_SRCS := \
	$(SRC)/elf/elf_abi.c \
	$(SRC)/fs/permission.c \
	$(SRC)/fs/devpts.c \
	$(SRC)/fs/cgroupfs.c \
	$(SRC)/fs/procfs.c \
	$(SRC)/fs/proc_sysctl.c \
	$(SRC)/vfs/append.c \
	$(SRC)/vfs/fallocate.c \
	$(SRC)/vfs/fileattr.c \
	$(SRC)/vfs/fiemap.c \
	$(SRC)/vfs/file_handle.c \
	$(SRC)/vfs/filesystem_registry.c \
	$(SRC)/vfs/inode_lifetime.c \
	$(SRC)/vfs/mount_namespace.c \
	$(SRC)/vfs/mount_snapshot.c \
	$(SRC)/vfs/mount_topology.c \
	$(SRC)/vfs/page_writeback.c \
	$(SRC)/vfs/path_cache.c \
	$(SRC)/vfs/readahead.c \
	$(SRC)/vfs/readahead_state.c \
	$(SRC)/vfs/resolve_superblock.c \
	$(SRC)/vfs/seek.c \
	$(SRC)/vfs/truncate.c \
	$(SRC)/vfs/writeback.c \
	$(SRC)/vfs/xattr.c \
	$(SRC)/dev/alsa.c \
	$(SRC)/dev/alsa_user_io.c \
	$(SRC)/dev/memdev.c \
	$(SRC)/kernel/boot_command_line.c \
