	$(SRC)/kernel/aio_runtime.c \
	$(SRC)/kernel/io_uring_runtime.c \
	$(SRC)/kernel/keyring_runtime.c \
	$(SRC)/kernel/sha1_runtime.c \
	$(SRC)/kernel/sha256_runtime.c \
	$(SRC)/kernel/sha512_runtime.c \
	$(SRC)/kernel/landlock_runtime.c \
