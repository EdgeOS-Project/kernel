ifeq ($(CONFIG_NFSD),y)
EDGE_SHARED_SRCS += \
	$(SRC)/fs/nfsd/nfsd_protocol.c \
	$(SRC)/fs/nfsd/nfsd_transport.c
endif

ifeq ($(CONFIG_FUSE_FS),y)
EDGE_SHARED_SRCS += $(SRC)/fs/fuse/fuse.c
endif

EDGE_ZLIB_SRCS := \
	$(SRC)/lib/zlib/adler32.c \
	$(SRC)/lib/zlib/crc32.c \
	$(SRC)/lib/zlib/inffast.c \
	$(SRC)/lib/zlib/inflate.c \
	$(SRC)/lib/zlib/inftrees.c \
	$(SRC)/lib/zlib/zutil.c

ifeq ($(CONFIG_INITRAMFS_GZIP),y)
EDGE_SHARED_SRCS += $(SRC)/lib/gzip.c
endif

ifneq ($(filter y,$(CONFIG_INITRAMFS_GZIP) $(CONFIG_BSD_DRIVER_BRIDGE) $(CONFIG_FS_SQUASHFS) $(ARM64_CONFIG_FS_SQUASHFS)),)
EDGE_SHARED_SRCS += $(EDGE_ZLIB_SRCS)
endif

ifneq ($(filter y,$(CONFIG_FS_SQUASHFS) $(ARM64_CONFIG_FS_SQUASHFS)),)
EDGE_SHARED_SRCS += \
	$(SRC)/fs/squashfs/squashfs.c \
	$(SRC)/fs/squashfs/squashfs_port.c \
	$(SRC)/fs/squashfs/upstream/cache.c \
	$(SRC)/fs/squashfs/upstream/decompress.c \
	$(SRC)/fs/squashfs/upstream/dir.c \
	$(SRC)/fs/squashfs/upstream/file.c \
	$(SRC)/fs/squashfs/upstream/fs.c \
	$(SRC)/fs/squashfs/upstream/swap.c \
	$(SRC)/fs/squashfs/upstream/table.c \
	$(SRC)/fs/squashfs/upstream/xattr.c
endif

ifneq ($(filter y,$(CONFIG_FS_EROFS) $(ARM64_CONFIG_FS_EROFS)),)
EDGE_SHARED_SRCS += \
	$(SRC)/fs/erofs/erofs.c \
	$(SRC)/fs/erofs/erofs_reader.c \
	$(SRC)/fs/erofs/lz4_decode.c
endif

ifneq ($(filter y,$(CONFIG_FS_XFS) $(ARM64_CONFIG_FS_XFS)),)
EDGE_SHARED_SRCS += \
	$(SRC)/fs/xfs/xfs.c \
	$(SRC)/fs/xfs/xfs_reader.c
endif

ifneq ($(filter y,$(CONFIG_FS_BTRFS) $(ARM64_CONFIG_FS_BTRFS)),)
EDGE_SHARED_SRCS += \
	$(SRC)/fs/btrfs/btrfs.c \
	$(SRC)/fs/btrfs/btrfs_reader.c
endif

ifneq ($(filter y,$(CONFIG_OVERLAY_FS) $(ARM64_CONFIG_OVERLAY_FS)),)
EDGE_SHARED_SRCS += $(SRC)/fs/overlayfs.c
endif

ifneq ($(filter y,$(CONFIG_FS_SWAP) $(ARM64_CONFIG_FS_SWAP)),)
EDGE_SHARED_SRCS += $(SRC)/fs/swap.c
endif

# Runtime composition that is already shared internally but is not yet linked
# by the legacy x86 process/syscall implementation.
EDGE_RUNTIME_SRCS := \
	$(SRC)/fs/vfs_early.c \
	$(SRC)/fs/sysfs.c \
	$(SRC)/elf/elf_image.c \
	$(SRC)/kernel/user_stack.c \
	$(SRC)/mm/fbdev_sync.c \
	$(SRC)/drivers/virtio/virtio_net_mmio.c \
	$(SRC)/drivers/virtio/virtio_input_mmio.c \
	$(SRC)/drivers/virtio/virtio_blk_mmio.c \
	$(SRC)/drivers/net/virtio_net_frontend.c \
	$(SRC)/drivers/block/ramdisk.c \
	$(SRC)/dev/devtmpfs.c \
	$(SRC)/fs/ext4/ext4.c \
	$(SRC)/fs/initramfs.c \
	$(EDGE_SHARED_SRCS) \
	$(LWIP_SRCS)

ifeq ($(ARM64_CONFIG_VIRTIO_GPU),y)
EDGE_RUNTIME_SRCS += $(SRC)/drivers/virtio/virtio_gpu.c \
	$(SRC)/drivers/virtio/virtio_gpu_damage.c
endif
