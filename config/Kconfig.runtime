menu "Mapping metadata capacities"
config RUNTIME_EXEC_ARGUMENT_BYTES
    int "Maximum aggregate exec argument and environment bytes"
    range 131072 2097152
    default 2097152
    help
      Full profiles retain the existing 2 MiB payload limit. Small profiles
      can use the 128 KiB floor to reduce each exec staging allocation.
      Requests exceeding the configured budget fail with E2BIG.

config RUNTIME_ARM64_VMA_MIN_ORDER
    int "Log2 of minimum ARM64 VMA records"
    range 8 14
    default 14

config RUNTIME_ARM64_FILE_PAGE_MIN_ORDER
    int "Log2 of minimum ARM64 file cache records"
    range 10 16
    default 16

config RUNTIME_CGROUP_NODES
    int "Cgroup hierarchy nodes"
    range 32 4096
    default 4096

config RUNTIME_ARM64_MAPPING_ORDER
    int "Log2 of ARM64 user mapping records"
    range 14 22
    default 22

config RUNTIME_RIGHTS_RECORDS
    int "SCM_RIGHTS token and record capacity"
    range 256 8192
    default 8192

config RUNTIME_MQ_MESSAGES
    int "POSIX message storage slots"
    range 64 512
    default 512

config RUNTIME_MEMFD_OBJECTS
    int "Memfd objects"
    range 4 128
    default 128

config RUNTIME_FILE_DESCRIPTION_ORDER
    int "Log2 of file description slots"
    range 6 15
    default 15

config RUNTIME_OVERLAY_INITIAL_CONTEXTS
    int "Initially reserved overlay scratch contexts"
    range 1 16
    default 16

config RUNTIME_PHYSICAL_POOL_MIB
    int "Physical backing pool ceiling in MiB"
    range 128 8192
    default 8192
    help
      Upper bound for x86 backing-page metadata. Actual pages still come
      from firmware-reported usable RAM. Full builds retain the existing cap.

config RUNTIME_MAPPED_FILES
    int "Concurrent mapped file records"
    range 64 4096
    default 4096

config RUNTIME_FILE_CACHE_ORDER
    int "Log2 of mapped file cache entries"
    range 8 18
    default 18
    help
      A power-of-two capacity preserves the cache hash mask invariant.
endmenu
