menu "File systems"
config FS_SWAP
    bool "Linux-compatible swap pager"
    default y

config FS_EXT2
    bool "ext2 filesystem support"
    default y

config FS_EXT4
    bool "ext4 filesystem support"
    default y

config FS_FAT32
    bool "FAT32 filesystem support"
    default y

config FS_EXFAT
    bool "exFAT filesystem read-only support"
    default y

config FS_NTFS
    bool "NTFS filesystem read-only support"
    default y

config FS_ISO9660
    bool "ISO9660 filesystem read-only support"
    default y

config FS_UDF
    bool "UDF filesystem read-only support"
    default y

config FS_SQUASHFS
    bool "SquashFS 4 read-only filesystem support"
    default y
    help
      Mount compressed SquashFS 4 images through the shared BSD-licensed
      reader core. Gzip compression is built in on both architectures.

config FS_EROFS
    bool "EROFS read-only filesystem support"
    default y
    help
      Mount Linux-compatible EROFS images through the architecture-neutral
      reader, including flat, inline, chunk-based data and LZ4 compressed
      compact or full indexes with standard or large physical clusters.

config FS_XFS
    bool "XFS v5 read-only filesystem support"
    default y
    help
      Mount modern XFS v5 filesystems through the shared architecture-neutral
      reader, including short and block directories, sparse and unwritten
      extents, symbolic links, and direct or B-tree extent maps.

config FS_BTRFS
    bool "Btrfs read-only filesystem support"
    default y
    help
      Mount Linux-compatible single-device Btrfs filesystems through the
      shared architecture-neutral tree and extent reader. Inline and regular
      uncompressed extents, sparse files, directories, and links are supported.

config NFSD
    bool "NFS version 3 server support"
    depends on NET
    default y
    help
      Serve VFS exports through the shared ONC RPC, mount protocol v3, and
      NFSv3 implementation over both TCP and UDP. Enable an export at boot
      with nfsd=1 nfsd.export=/absolute/path.

config FUSE_FS
    bool "FUSE userspace filesystem support"
    default y
    help
      Provide the Linux-compatible /dev/fuse transport and shared VFS client.
      This supports production userspace filesystems such as ceph-fuse without
      placing their filesystem policy in the kernel.

config OVERLAY_FS
    bool "basic OverlayFS support (runtime whiteouts, no persistent xattr whiteouts yet)"
    default n
endmenu
