menu "Firmware Drivers"
config DEVICE_TREE
    bool "Flattened Device Tree support"
    default y if ARCH_ARM64
    default n
    help
      Validate and expose firmware Device Tree nodes, properties, register
      ranges, and interrupts through the shared OFW model used by platform
      drivers. ARM64 retains its minimal early boot parser when this is off.

config EFI_RUNTIME
    bool "EFI Runtime Services"
    default n

config EFI_GOP
    bool "EFI GOP framebuffer handoff"
    depends on EFI_RUNTIME
    default n
endmenu

menu "Device Drivers"

menu "Block devices"
config LOOP_DEVICE
    bool "Loopback block device support"
    default y
    help
      Expose Linux-compatible /dev/loop-control and file-backed /dev/loopN
      block devices for mounting filesystem images on both architectures.

config DEVICE_MAPPER
    bool "Linux-compatible device mapper"
    default y
    help
      Provide /dev/mapper/control, dm-N block devices, atomic table switching,
      and the shared linear, striped, zero, and error mapping targets used by
      Linux storage-management tools.

