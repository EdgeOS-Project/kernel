# EdgeOS x86 architecture configuration

menu "Processor type and features"
config COMPAT_IA32
    bool "IA-32 compatibility ABI"
    depends on ARCH_X86_64
    default y
    help
      Enable ELF32/EM_386 process loading and the Linux i386 int 0x80
      system call ABI. Compatibility structure conversion remains explicit;
      calls without an audited conversion return ENOSYS.

config UID16
    bool "Legacy 16-bit UID system calls"
    depends on COMPAT_IA32
    default y
    help
      Enable the historical Linux i386 identity and ownership system calls
      whose public user and group identifiers are 16 bits wide.

config X86_X32_ABI
    bool "x32 ABI for 64-bit processes"
    depends on ARCH_X86_64
    default y
    help
      Enable Linux x32 system call number decoding. System calls whose
      argument and result layouts are identical to the native x86-64 ABI use
      the shared implementation; compatibility structure conversion remains
      explicit for all other calls.

config MODIFY_LDT_SYSCALL
    bool "Legacy modify_ldt system call"
    depends on ARCH_X86_64
    default y
    help
      Provide the native x86 Linux modify_ldt ABI used by compatibility
      runtimes and legacy applications. The descriptor table remains private
      to an address space and is inherited across fork.

config X86_16BIT
    bool "16-bit segment support"
    depends on ARCH_X86_64 && MODIFY_LDT_SYSCALL
    default n
    help
      Permit 16-bit LDT data and stack segments. Leave this disabled until
      the x86 exception return path provides the required stack fixup model.

config APIC
    bool "Local APIC support"
    default n

config IOAPIC
    bool "IOAPIC support"
    default n

config CPUFREQ_INTEL_PSTATE
    bool "Intel P-State CPU frequency scaling"
    default y
endmenu

menu "Power management and ACPI options"
config ACPI
    bool "ACPI core support"
    default y

config ACPI_AC_ADAPTER
    bool "ACPI AC adapter driver"
    depends on BSD_DRIVER_ACPICA
    default y
    help
      Enable the complete imported ACPI adapter driver and Linux-compatible
      power-supply state reporting.

config ACPI_BATTERY
    bool "ACPI control-method battery driver"
    depends on BSD_DRIVER_ACPICA
    default y
    help
      Enable the complete imported control-method battery driver and publish
      its live state through Linux-compatible power-supply attributes.

config ACPI_EC
    bool "ACPI embedded controller driver"
    depends on BSD_DRIVER_ACPICA
    default y
    help
      Enable the complete imported ACPI embedded-controller driver, including
      ECDT discovery, GPE handling, address-space access, and burst transfers.

config ACPI_DOCK
    bool "ACPI docking station driver"
    depends on BSD_DRIVER_ACPICA
    default y
    help
      Enable the complete imported ACPI docking-station driver, including
      dependency discovery, notifications, locking, and eject handling.

config ACPI_POWER_RESOURCE
    bool "ACPI power resource driver"
    depends on BSD_DRIVER_ACPICA
    default y
    help
      Enable the complete imported ACPI power-resource driver and its
      dependency-aware reference counting.

config ACPI_BUTTON
    bool "ACPI power/sleep/lid button drivers (requires ACPICA event support)"
    default n

config HPET
    bool "HPET timer support"
    depends on ACPI
    default y

config RTC
    bool "RTC driver"
    default y

config ACPI_THERMAL
    bool "ACPI thermal zone driver"
    depends on BSD_DRIVER_ACPICA
    default y
    help
      Enable the complete imported ACPI thermal-zone driver, including
      temperature polling, firmware notifications, active cooling devices,
      critical-temperature handling, and passive CPU-frequency cooling.

config FAN_CONTROLLER
    bool "Fan controller support (requires ACPI/platform driver)"
    default n
endmenu

